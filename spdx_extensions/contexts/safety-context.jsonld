{
  "@context": {
    "xSafety": "https://example.org/spdx-extensions/xSafety/",
    
    "HazardExtension": "xSafety:HazardExtension",
    "SafetyGoalExtension": "xSafety:SafetyGoalExtension",
    "SafetyExtension": "xSafety:SafetyExtension",
    "SafetyRequirementExtension": "xSafety:SafetyRequirementExtension",
    "SafetyEvidenceExtension": "xSafety:SafetyEvidenceExtension",
    "SafetyTestExtension": "xSafety:SafetyTestExtension",
    
    "xSafety:severity": {
      "@id": "xSafety:severity",
      "@type": "@vocab"
    },
    "xSafety:exposure": {
      "@id": "xSafety:exposure",
      "@type": "@vocab"
    },
    "xSafety:controllability": {
      "@id": "xSafety:controllability",
      "@type": "@vocab"
    },
    "xSafety:safetyIntegrityLevel": {
      "@id": "xSafety:safetyIntegrityLevel",
      "@type": "@vocab"
    },
    "xSafety:safetyRelevant": {
      "@id": "xSafety:safetyRelevant",
      "@type": "http://www.w3.org/2001/XMLSchema#boolean"
    },
    "xSafety:complianceStatus": {
      "@id": "xSafety:complianceStatus",
      "@type": "@vocab"
    },
    "xSafety:requirementType": {
      "@id": "xSafety:requirementType",
      "@type": "@vocab"
    },
    "xSafety:evidenceType": {
      "@id": "xSafety:evidenceType",
      "@type": "@vocab"
    },
    "xSafety:evidenceResult": {
      "@id": "xSafety:evidenceResult",
      "@type": "@vocab"
    },
    "xSafety:validUntil": {
      "@id": "xSafety:validUntil",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "xSafety:testType": {
      "@id": "xSafety:testType",
      "@type": "@vocab"
    },
    "xSafety:testSteps": {
      "@id": "xSafety:testSteps",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    },
    "xSafety:expectedResult": {
      "@id": "xSafety:expectedResult",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    },
    
    "s0": "xSafety:s0",
